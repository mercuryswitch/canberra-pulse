# Copy this file to `.env` and fill in real values. `.env` is git-ignored -
# never commit it. See SECURITY.md for which of these are (and aren't)
# actually secret.

# Direct Eventhouse (Kusto) access - the browser queries ACTGovEventHouse
# directly with the signed-in user's token (MSAL). Not secrets: a SPA client
# ID and tenant ID are meant to be public in frontend bundles.
VITE_KUSTO_CLUSTER=https://your-cluster.kusto.fabric.microsoft.com
VITE_KUSTO_DATABASE=ACTGovEventHouse
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional: ion.cesium.com -> Access Tokens, for photorealistic 3D tiles.
# Falls back to keyless OpenStreetMap tiles if left blank.
VITE_CESIUM_ION_TOKEN=

# Transport Canberra static GTFS bundle (for the build-time route-shapes
# snapshot only - Node/build process, no VITE_ prefix, never sent to the
# browser). Free developer key: see README.md.
TC_GTFS_CLIENT_ID=your-client-id
TC_GTFS_CLIENT_SECRET=your-client-secret
